<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CounterMCh4E2.Views.AllCountersPage"
             xmlns:controls="clr-namespace:CounterMCh4E2.Views"
             xmlns:models="clr-namespace:CounterMCh4E2.Models"
             x:DataType="models:AllCounters"
             Title="Liczniki">

    <ScrollView>
        <StackLayout>
            <StackLayout Margin="10">
                <Label Text="Dodaj nowy licznik:" 
                   HorizontalTextAlignment="Center"
                   FontSize="20"
                   Margin="5"/>
                <Label x:Name="ErrorLabel"
                   BackgroundColor="#aa0000"
                   TextColor="white"
                   FontSize="15"
                   Text=""
                   WidthRequest="400"
                   HorizontalTextAlignment="Center"
                   IsVisible="False"
                   Padding="5"
                   Margin="5"/>
                <FlexLayout JustifyContent="Center" HeightRequest="70">
                    <Entry x:Name="NameEntry" Placeholder="Podaj nazwę" Margin="2" WidthRequest="200"/>
                    <Entry x:Name="InitialValueEntry" Placeholder="Podaj wartość początkową" Margin="2" WidthRequest="200"/>
                    <Picker x:Name="ColorPicker"
                        Title="Wybierz kolor licznika:"
                        Margin="2"
                        WidthRequest="150">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Czerwony</x:String>
                                <x:String>Niebieski</x:String>
                                <x:String>Zielony</x:String>
                                <x:String>Żółty</x:String>
                                <x:String>Różowy</x:String>
                                <x:String>Turkusowy</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                        <Picker.SelectedIndex>0</Picker.SelectedIndex>

                    </Picker>
                    <Button Text="Dodaj" 
                        Clicked="AddCounter_Clicked"
                        Margin="2"
                        WidthRequest="70"/>
                </FlexLayout>
            </StackLayout>
            <CollectionView x:Name="countersCollection"
                            ItemsSource="{Binding Counters}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                    HorizontalItemSpacing="10"
                                    VerticalItemSpacing="10"
                                     Span="4"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>

                    <DataTemplate x:DataType="models:Counter">
                        <controls:CounterView CounterObject="{Binding}"/>
                    </DataTemplate>

                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>